/target
# The desktop shell is its own workspace, so its build output lands here rather than in /target
# above (release.yml says the same thing about where it looks for the bundle). Anyone who builds
# the shell locally got an untracked directory until this line existed.
/app/target
**/*.rs.bk
Cargo.lock.orig
.DS_Store
/data
*.log
# fastembed's local model cache (large ONNX binaries - never committed)
**/.fastembed_cache/
# Dev-only lint tooling for the viewer's frontend assets. The build embeds them with include_str!
# and needs no Node, so node_modules is never committed.
**/node_modules/
.eslintcache
# Capability schemas generated by tauri-build (the desktop shell)
/app/gen/
