<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The signed app's entitlements (tauri.conf.json bundle.macOS.entitlements). Under the hardened
     runtime an app may ask to send Apple events only with this one, which the Welcome page's "Restart
     Claude Desktop" needs to ask Claude Desktop to quit, as the Dock's Quit does (docs/onboarding.md
     Section 4.2, D9). Nothing else is granted. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
