<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the bundle's Info.plist. The one key it adds is what macOS shows when the
     Welcome page asks Claude Desktop to quit and opens it again (docs/onboarding.md Section 4.2, D9):
     the person is asked once whether this app may do that, and a refusal leaves the instruction to do
     it by hand. -->
<plist version="1.0">
<dict>
  <key>NSAppleEventsUsageDescription</key>
  <string>Supragnosis asks Claude Desktop to quit and opens it again, so it loads the connection you just made.</string>
</dict>
</plist>
